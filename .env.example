ENV=development
DATABASE_URL=sqlite+aiosqlite:///./app.db
SECRET_KEY=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=90
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=KeBook

OTP_EXPIRE_SECONDS=90
OTP_LENGTH=6

# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=

# Optional: enforce DB TLS certificate verification
MYSQL_SSL_CA=
MYSQL_SSL_VERIFY=true

REVIEW_REWARD_POINTS=10
REVIEW_WINDOW_DAYS=30
BOOK_VIEW_DEBOUNCE_MINUTES=30
LOYALTY_POINT_VALUE_VND=1.0
LOYALTY_MAX_ORDER_POINTS_DISCOUNT_PERCENT=50
